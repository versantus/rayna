        entry="RaynaApp" launcherIcon="@Drawables.LauncherIcon" minApiLevel="4.2.0">
        <iq:products>
            <!-- Installed in the local SDK today. Add fr255*, fr265*, fenix7*, fenix8* once downloaded in SDK Manager (docs/garmin/PLAN.md). -->
            <iq:product id="fr955"/>
            <iq:product id="fr965"/>
        </iq:products>
        <iq:permissions>
            <iq:uses-permission id="Communications"/>
